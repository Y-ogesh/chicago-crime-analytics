# Copy this file to .env and provide local values. Never commit .env.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chicago_crime
POSTGRES_USER=chicago_crime_user
POSTGRES_PASSWORD=
POSTGRES_SSLMODE=prefer

# Public City of Chicago Socrata dataset identifier.
CHICAGO_CRIME_DATASET_ID=ijzp-q8t2

# Optional Socrata application token. Leave blank for unauthenticated requests.
SOCRATA_APP_TOKEN=

# Repository-relative data locations.
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

