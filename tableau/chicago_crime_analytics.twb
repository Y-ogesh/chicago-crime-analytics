      <column datatype="date" name="[month_start]" role="dimension" type="ordinal" />
      <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
      <column datatype="integer" name="[crime_month]" role="measure" type="quantitative" />
      <column datatype="string" name="[month_name]" role="dimension" type="nominal" />
      <column datatype="integer" name="[crime_quarter]" role="measure" type="quantitative" />
      <column datatype="string" name="[season]" role="dimension" type="nominal" />
      <column datatype="integer" name="[season_order]" role="measure" type="quantitative" />
      <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
      <column datatype="integer" name="[annual_category_rank]" role="measure" type="quantitative" />
      <column datatype="integer" name="[day_of_week_num]" role="measure" type="quantitative" />
      <column datatype="string" name="[day_of_week]" role="dimension" type="nominal" />
      <column datatype="integer" name="[hour_of_day]" role="measure" type="quantitative" />
      <column datatype="string" name="[time_of_day]" role="dimension" type="nominal" />
      <column datatype="string" name="[time_of_day_display]" role="dimension" type="nominal" />
      <column datatype="integer" name="[time_of_day_order]" role="measure" type="quantitative" />
      <column datatype="integer" name="[weekend_flag]" role="measure" type="quantitative" />
      <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
      <column datatype="integer" name="[arrest_count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[arrest_indicator_denominator]" role="measure" type="quantitative" />
      <column datatype="integer" name="[domestic_count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[domestic_indicator_denominator]" role="measure" type="quantitative" />
      <column caption="Selected Year Filter" datatype="boolean" name="[Calculation_SelectedYear]" role="dimension" type="nominal">
        <calculation class="tableau" formula="STR([crime_year]) = [Parameters].[pSelectedYear]" />
      </column>
      <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
      </column>
      <column caption="Show Leading Categories" datatype="boolean" name="[Calculation_TemporalCategoryDisplay]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[pCrimeType] &lt;&gt; &quot;All Crime Types&quot; OR [annual_category_rank] &lt;= 5" />
      </column>
      <column caption="Time of Day Display" datatype="string" name="[Calculation_TimeOfDayDisplay]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [time_of_day] = &quot;Overnight&quot; THEN &quot;Night&quot; ELSE [time_of_day] END" />
      </column>
      <column caption="Hour Label" datatype="string" name="[Calculation_HourLabel]" role="dimension" type="nominal">
        <calculation class="tableau" formula="RIGHT(&quot;0&quot; + STR([hour_of_day]), 2) + &quot;:00&quot;" />
      </column>
      <column caption="Arrest Percentage" datatype="real" name="[Calculation_TemporalArrestPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
        <calculation class="tableau" formula="IF SUM([arrest_indicator_denominator]) = 0 THEN NULL ELSE 100.0 * SUM([arrest_count]) / SUM([arrest_indicator_denominator]) END" />
      </column>
      <column caption="Domestic Incident Percentage" datatype="real" name="[Calculation_TemporalDomesticPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
        <calculation class="tableau" formula="IF SUM([domestic_indicator_denominator]) = 0 THEN NULL ELSE 100.0 * SUM([domestic_count]) / SUM([domestic_indicator_denominator]) END" />
      </column>
      <column caption="Peak Hour Label" datatype="string" name="[Calculation_PeakHourLabel]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF RANK_UNIQUE(SUM([reported_incident_count]), &quot;desc&quot;) = 1 THEN MIN([Calculation_HourLabel]) + CHAR(10) + STR(SUM([reported_incident_count])) + &quot; incidents&quot; END" />
      </column>
      <column caption="Peak Day Label" datatype="string" name="[Calculation_PeakDayLabel]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF RANK_UNIQUE(SUM([reported_incident_count]), &quot;desc&quot;) = 1 THEN MIN([day_of_week]) + CHAR(10) + STR(SUM([reported_incident_count])) + &quot; incidents&quot; END" />
      </column>
      <column caption="Peak Month Label" datatype="string" name="[Calculation_PeakMonthLabel]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF RANK_UNIQUE(SUM([reported_incident_count]), &quot;desc&quot;) = 1 THEN MIN([month_name]) + CHAR(10) + STR(SUM([reported_incident_count])) + &quot; incidents&quot; END" />
      </column>
    </datasource>
