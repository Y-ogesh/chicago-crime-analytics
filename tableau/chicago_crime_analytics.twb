        <rows />
        <cols />
      </table>
    </worksheet>
    <worksheet name="P3 Day-Hour Heatmap">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#243447" fontname="Tableau Semibold" fontsize="12">Reported Incidents by Day and Hour</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Temporal Detail" name="TemporalDS" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="TemporalDS">
            <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
            <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
            <column datatype="string" name="[day_of_week]" role="dimension" type="nominal" />
            <column datatype="integer" name="[day_of_week_num]" role="measure" type="quantitative" />
            <column datatype="integer" name="[hour_of_day]" role="measure" type="quantitative" />
            <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
            <column datatype="integer" name="[arrest_count]" role="measure" type="quantitative" />
            <column datatype="integer" name="[arrest_indicator_denominator]" role="measure" type="quantitative" />
            <column datatype="integer" name="[domestic_count]" role="measure" type="quantitative" />
            <column datatype="integer" name="[domestic_indicator_denominator]" role="measure" type="quantitative" />
            <column caption="Selected Year Filter" datatype="boolean" name="[Calculation_SelectedYear]" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR([crime_year]) = [Parameters].[pSelectedYear]" />
            </column>
            <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
            </column>
            <column caption="Hour Label" datatype="string" name="[Calculation_HourLabel]" role="dimension" type="nominal">
              <calculation class="tableau" formula="RIGHT(&quot;0&quot; + STR([hour_of_day]), 2) + &quot;:00&quot;" />
            </column>
            <column caption="Arrest Percentage" datatype="real" name="[Calculation_TemporalArrestPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
              <calculation class="tableau" formula="IF SUM([arrest_indicator_denominator]) = 0 THEN NULL ELSE 100.0 * SUM([arrest_count]) / SUM([arrest_indicator_denominator]) END" />
            </column>
            <column caption="Domestic Incident Percentage" datatype="real" name="[Calculation_TemporalDomesticPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
              <calculation class="tableau" formula="IF SUM([domestic_indicator_denominator]) = 0 THEN NULL ELSE 100.0 * SUM([domestic_count]) / SUM([domestic_indicator_denominator]) END" />
            </column>
            <column-instance column="[day_of_week]" derivation="None" name="[none:day_of_week:nk]" pivot="key" type="nominal" />
            <column-instance column="[day_of_week_num]" derivation="Min" name="[min:day_of_week_num:qk]" pivot="key" type="quantitative" />
            <column-instance column="[hour_of_day]" derivation="None" name="[none:hour_of_day:ok]" pivot="key" type="ordinal" />
            <column-instance column="[reported_incident_count]" derivation="Sum" name="[sum:reported_incident_count:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calculation_TemporalArrestPercentage]" derivation="User" name="[usr:Calculation_TemporalArrestPercentage:qk]" pivot="key" type="quantitative" />
            <column-instance column="[Calculation_TemporalDomesticPercentage]" derivation="User" name="[usr:Calculation_TemporalDomesticPercentage:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Year" datatype="string" name="[pSelectedYear]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025&quot;">
              <calculation class="tableau" formula="&quot;2025&quot;" />
            </column>
            <column caption="Crime Type" datatype="string" name="[pCrimeType]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Crime Types&quot;">
              <calculation class="tableau" formula="&quot;All Crime Types&quot;" />
            </column>
            <column caption="Community Area" datatype="string" name="[pCommunityArea]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Community Areas&quot;">
              <calculation class="tableau" formula="&quot;All Community Areas&quot;" />
            </column>
            <column caption="Police District" datatype="string" name="[pDistrict]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Police Districts&quot;">
              <calculation class="tableau" formula="&quot;All Police Districts&quot;" />
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[TemporalDS].[Calculation_SelectedYear]">
            <groupfilter function="member" level="[Calculation_SelectedYear]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[TemporalDS].[Calculation_SelectedCrimeType]">
            <groupfilter function="member" level="[Calculation_SelectedCrimeType]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <sort class="computed" column="[TemporalDS].[none:day_of_week:nk]" direction="ASC" using="[TemporalDS].[min:day_of_week_num:qk]" />
          <slices>
            <column>[TemporalDS].[Calculation_SelectedYear]</column>
            <column>[TemporalDS].[Calculation_SelectedCrimeType]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#243447" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Square" />
            <encodings>
              <color column="[TemporalDS].[sum:reported_incident_count:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor="#666666">Day: </run>
                <run bold="true">&lt;[TemporalDS].[none:day_of_week:nk]&gt;</run>
                <run fontcolor="#666666">
Hour: </run>
                <run bold="true">&lt;[TemporalDS].[none:hour_of_day:ok]&gt;:00</run>
                <run fontcolor="#666666">
Reported incidents: </run>
                <run bold="true">&lt;[TemporalDS].[sum:reported_incident_count:qk]&gt;</run>
                <run fontcolor="#666666">
Recorded times may be estimated.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="false" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[TemporalDS].[none:day_of_week:nk]</rows>
        <cols>[TemporalDS].[none:hour_of_day:ok]</cols>
      </table>
    </worksheet>
