                <format attr="mark-labels-show" value="true" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
              <style-rule element="datalabel">
                <format attr="font-family" value="Tableau Semibold" />
                <format attr="font-size" value="18" />
                <format attr="color" value="#17324D" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
        <tooltip-style tooltip-mode="none" />
      </table>
    </worksheet>
    <worksheet name="Chicago Geographic Crime Map">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#243447" fontname="Tableau Semibold" fontsize="12">Descriptive Incident Density — 0.01° Coordinate Cells</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Geographic Detail" name="GeographicDS" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="GeographicDS">
            <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
            <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
            <column datatype="string" name="[community_area_name]" role="dimension" type="nominal" />
            <column datatype="string" name="[district_label]" role="dimension" type="nominal" />
            <column datatype="integer" name="[coordinate_mappable_flag]" role="measure" type="quantitative" />
            <column datatype="real" name="[cell_latitude]" role="measure" type="quantitative" caption="Latitude" semantic-role="[Geographical].[Latitude]" aggregation="Avg" />
            <column datatype="real" name="[cell_longitude]" role="measure" type="quantitative" caption="Longitude" semantic-role="[Geographical].[Longitude]" aggregation="Avg" />
            <column datatype="string" name="[density_cell_id]" role="dimension" type="nominal" />
            <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
            <column caption="Selected Year Filter" datatype="boolean" name="[Calculation_SelectedYear]" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR([crime_year]) = [Parameters].[pSelectedYear]" />
            </column>
            <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
            </column>
            <column caption="Selected Community Area Filter" datatype="boolean" name="[Calculation_SelectedCommunityArea]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCommunityArea] = &quot;All Community Areas&quot; OR [community_area_name] = [Parameters].[pCommunityArea]" />
            </column>
            <column caption="Selected Police District Filter" datatype="boolean" name="[Calculation_SelectedDistrict]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pDistrict] = &quot;All Police Districts&quot; OR [district_label] = [Parameters].[pDistrict]" />
            </column>
            <column caption="Coordinate-Mappable Record" datatype="boolean" name="[Calculation_MappableRecord]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[coordinate_mappable_flag] = 1" />
            </column>
            <column-instance column="[cell_latitude]" derivation="Avg" name="[avg:cell_latitude:qk]" pivot="key" type="quantitative" />
            <column-instance column="[cell_longitude]" derivation="Avg" name="[avg:cell_longitude:qk]" pivot="key" type="quantitative" />
            <column-instance column="[density_cell_id]" derivation="None" name="[none:density_cell_id:nk]" pivot="key" type="nominal" />
            <column-instance column="[reported_incident_count]" derivation="Sum" name="[sum:reported_incident_count:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Year" datatype="string" name="[pSelectedYear]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025&quot;">
              <calculation class="tableau" formula="&quot;2025&quot;" />
            </column>
            <column caption="Crime Type" datatype="string" name="[pCrimeType]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Crime Types&quot;">
              <calculation class="tableau" formula="&quot;All Crime Types&quot;" />
            </column>
            <column caption="Community Area" datatype="string" name="[pCommunityArea]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Community Areas&quot;">
              <calculation class="tableau" formula="&quot;All Community Areas&quot;" />
            </column>
            <column caption="Police District" datatype="string" name="[pDistrict]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Police Districts&quot;">
              <calculation class="tableau" formula="&quot;All Police Districts&quot;" />
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[GeographicDS].[Calculation_SelectedYear]">
            <groupfilter function="member" level="[Calculation_SelectedYear]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[GeographicDS].[Calculation_SelectedCrimeType]">
            <groupfilter function="member" level="[Calculation_SelectedCrimeType]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[GeographicDS].[Calculation_SelectedCommunityArea]">
            <groupfilter function="member" level="[Calculation_SelectedCommunityArea]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[GeographicDS].[Calculation_SelectedDistrict]">
            <groupfilter function="member" level="[Calculation_SelectedDistrict]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[GeographicDS].[Calculation_MappableRecord]">
            <groupfilter function="member" level="[Calculation_MappableRecord]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[GeographicDS].[Calculation_SelectedYear]</column>
            <column>[GeographicDS].[Calculation_SelectedCrimeType]</column>
            <column>[GeographicDS].[Calculation_SelectedCommunityArea]</column>
            <column>[GeographicDS].[Calculation_SelectedDistrict]</column>
            <column>[GeographicDS].[Calculation_MappableRecord]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#243447" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Circle" />
            <encodings>
              <color column="[GeographicDS].[sum:reported_incident_count:qk]" />
              <size column="[GeographicDS].[sum:reported_incident_count:qk]" />
              <lod column="[GeographicDS].[none:density_cell_id:nk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor="#666666">Coordinate cell: </run>
                <run bold="true">&lt;[GeographicDS].[none:density_cell_id:nk]&gt;</run>
                <run fontcolor="#666666">
Reported incidents: </run>
                <run bold="true">&lt;[GeographicDS].[sum:reported_incident_count:qk]&gt;</run>
                <run fontcolor="#666666">
Descriptive 0.01-degree cell; not a statistical hotspot test.</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="false" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[GeographicDS].[avg:cell_latitude:qk]</rows>
        <cols>[GeographicDS].[avg:cell_longitude:qk]</cols>
      </table>
    </worksheet>
