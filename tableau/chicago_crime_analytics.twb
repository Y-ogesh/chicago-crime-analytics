      <aliases enabled="yes" />
      <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
      <column datatype="date" name="[period_start]" role="dimension" type="ordinal" />
      <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
      <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
      <column datatype="integer" name="[yearly_reported_incident_count]" role="measure" type="quantitative" />
      <column datatype="real" name="[percentage_of_year_total]" role="measure" type="quantitative" />
      <column datatype="integer" name="[incident_volume_rank]" role="measure" type="quantitative" />
      <column datatype="integer" name="[previous_year]" role="measure" type="quantitative" />
      <column datatype="integer" name="[previous_year_incident_count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[absolute_change]" role="measure" type="quantitative" />
      <column datatype="real" name="[percentage_change]" role="measure" type="quantitative" />
      <column datatype="integer" name="[arrest_count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[arrest_indicator_denominator]" role="measure" type="quantitative" />
      <column datatype="real" name="[arrest_percentage]" role="measure" type="quantitative" />
      <column datatype="integer" name="[domestic_count]" role="measure" type="quantitative" />
      <column datatype="integer" name="[domestic_indicator_denominator]" role="measure" type="quantitative" />
      <column datatype="real" name="[domestic_incident_percentage]" role="measure" type="quantitative" />
      <column caption="Selected Year Filter" datatype="boolean" name="[Calculation_SelectedYear]" role="dimension" type="nominal">
        <calculation class="tableau" formula="STR([crime_year]) = [Parameters].[pSelectedYear]" />
      </column>
      <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
      </column>
      <column caption="Show Category in Distribution" datatype="boolean" name="[Calculation_CategoryDisplay]" role="dimension" type="nominal">
        <calculation class="tableau" formula="[Parameters].[pCrimeType] &lt;&gt; &quot;All Crime Types&quot; OR [incident_volume_rank] &lt;= 10" />
      </column>
      <column caption="Weighted Arrest Percentage" datatype="real" name="[Calculation_ArrestPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
        <calculation class="tableau" formula="IF SUM([arrest_indicator_denominator]) = 0 THEN NULL ELSE 100.0 * SUM([arrest_count]) / SUM([arrest_indicator_denominator]) END" />
      </column>
      <column caption="Weighted Domestic Incident Percentage" datatype="real" name="[Calculation_DomesticPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
        <calculation class="tableau" formula="IF SUM([domestic_indicator_denominator]) = 0 THEN NULL ELSE 100.0 * SUM([domestic_count]) / SUM([domestic_indicator_denominator]) END" />
      </column>
    </datasource>
