      <table>
        <view>
          <datasources>
            <datasource caption="Executive Category Year" name="AnnualDS" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="AnnualDS">
            <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
            <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
            <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
            <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
            </column>
            <column-instance column="[crime_year]" derivation="None" name="[none:crime_year:ok]" pivot="key" type="ordinal" />
            <column-instance column="[reported_incident_count]" derivation="Sum" name="[sum:reported_incident_count:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Year" datatype="string" name="[pSelectedYear]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025&quot;">
              <calculation class="tableau" formula="&quot;2025&quot;" />
            </column>
            <column caption="Crime Type" datatype="string" name="[pCrimeType]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Crime Types&quot;">
              <calculation class="tableau" formula="&quot;All Crime Types&quot;" />
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[AnnualDS].[Calculation_SelectedCrimeType]">
            <groupfilter function="member" level="[Calculation_SelectedCrimeType]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[AnnualDS].[Calculation_SelectedCrimeType]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#243447" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <text column="[AnnualDS].[sum:reported_incident_count:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor="#666666">Year: </run>
                <run bold="true">&lt;[AnnualDS].[none:crime_year:ok]&gt;</run>
                <run fontcolor="#666666">
Reported incidents: </run>
                <run bold="true">&lt;[AnnualDS].[sum:reported_incident_count:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
              <style-rule element="datalabel">
                <format attr="font-family" value="Tableau Semibold" />
                <format attr="font-size" value="9" />
                <format attr="color" value="#17324D" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[AnnualDS].[sum:reported_incident_count:qk]</rows>
        <cols>[AnnualDS].[none:crime_year:ok]</cols>
      </table>
    </worksheet>
    <worksheet name="Crime Category Distribution">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#243447" fontname="Tableau Semibold" fontsize="12">Top Crime Categories by Reported Incidents</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Executive Category Year" name="AnnualDS" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="AnnualDS">
            <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
            <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
            <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
            <column datatype="integer" name="[incident_volume_rank]" role="measure" type="quantitative" />
            <column caption="Selected Year Filter" datatype="boolean" name="[Calculation_SelectedYear]" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR([crime_year]) = [Parameters].[pSelectedYear]" />
            </column>
            <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
            </column>
            <column caption="Show Category in Distribution" datatype="boolean" name="[Calculation_CategoryDisplay]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] &lt;&gt; &quot;All Crime Types&quot; OR [incident_volume_rank] &lt;= 10" />
            </column>
            <column-instance column="[primary_type]" derivation="None" name="[none:primary_type:nk]" pivot="key" type="nominal" />
            <column-instance column="[reported_incident_count]" derivation="Sum" name="[sum:reported_incident_count:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Year" datatype="string" name="[pSelectedYear]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025&quot;">
              <calculation class="tableau" formula="&quot;2025&quot;" />
            </column>
            <column caption="Crime Type" datatype="string" name="[pCrimeType]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Crime Types&quot;">
              <calculation class="tableau" formula="&quot;All Crime Types&quot;" />
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[AnnualDS].[Calculation_SelectedYear]">
            <groupfilter function="member" level="[Calculation_SelectedYear]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[AnnualDS].[Calculation_SelectedCrimeType]">
            <groupfilter function="member" level="[Calculation_SelectedCrimeType]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[AnnualDS].[Calculation_CategoryDisplay]">
            <groupfilter function="member" level="[Calculation_CategoryDisplay]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <sort class="computed" column="[AnnualDS].[none:primary_type:nk]" direction="DESC" using="[AnnualDS].[sum:reported_incident_count:qk]" />
          <slices>
            <column>[AnnualDS].[Calculation_SelectedYear]</column>
            <column>[AnnualDS].[Calculation_SelectedCrimeType]</column>
            <column>[AnnualDS].[Calculation_CategoryDisplay]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#243447" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Bar" />
            <encodings>
              <text column="[AnnualDS].[sum:reported_incident_count:qk]" />
            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run fontcolor="#666666">Crime type: </run>
                <run bold="true">&lt;[AnnualDS].[none:primary_type:nk]&gt;</run>
                <run fontcolor="#666666">
Reported incidents: </run>
                <run bold="true">&lt;[AnnualDS].[sum:reported_incident_count:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="true" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[AnnualDS].[none:primary_type:nk]</rows>
        <cols>[AnnualDS].[sum:reported_incident_count:qk]</cols>
      </table>
    </worksheet>
    <worksheet name="Monthly Crime Trend">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#243447" fontname="Tableau Semibold" fontsize="12">Monthly Reported-Incident Trend</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Executive Month Category" name="MonthlyDS" />
            <datasource name="Parameters" />
          </datasources>
          <datasource-dependencies datasource="MonthlyDS">
            <column datatype="date" name="[month_start]" role="dimension" type="ordinal" />
            <column datatype="integer" name="[crime_year]" role="measure" type="quantitative" />
            <column datatype="string" name="[primary_type]" role="dimension" type="nominal" />
            <column datatype="integer" name="[reported_incident_count]" role="measure" type="quantitative" caption="Reported Incidents" />
            <column datatype="real" name="[trailing_three_month_average]" role="measure" type="quantitative" />
            <column caption="Selected Year Filter" datatype="boolean" name="[Calculation_SelectedYear]" role="dimension" type="nominal">
              <calculation class="tableau" formula="STR([crime_year]) = [Parameters].[pSelectedYear]" />
            </column>
            <column caption="Selected Crime Type Filter" datatype="boolean" name="[Calculation_SelectedCrimeType]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
            </column>
            <column-instance column="[month_start]" derivation="Month-Trunc" name="[tmn:month_start:ok]" pivot="key" type="ordinal" />
            <column-instance column="[reported_incident_count]" derivation="Sum" name="[sum:reported_incident_count:qk]" pivot="key" type="quantitative" />
            <column-instance column="[trailing_three_month_average]" derivation="Sum" name="[sum:trailing_three_month_average:qk]" pivot="key" type="quantitative" />
          </datasource-dependencies>
          <datasource-dependencies datasource="Parameters">
            <column caption="Year" datatype="string" name="[pSelectedYear]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025&quot;">
              <calculation class="tableau" formula="&quot;2025&quot;" />
            </column>
            <column caption="Crime Type" datatype="string" name="[pCrimeType]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Crime Types&quot;">
              <calculation class="tableau" formula="&quot;All Crime Types&quot;" />
            </column>
          </datasource-dependencies>
          <filter class="categorical" column="[MonthlyDS].[Calculation_SelectedYear]">
            <groupfilter function="member" level="[Calculation_SelectedYear]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <filter class="categorical" column="[MonthlyDS].[Calculation_SelectedCrimeType]">
            <groupfilter function="member" level="[Calculation_SelectedCrimeType]" member="true" user:ui-domain="database" user:ui-enumeration="inclusive" user:ui-marker="enumerate" />
          </filter>
          <slices>
            <column>[MonthlyDS].[Calculation_SelectedYear]</column>
            <column>[MonthlyDS].[Calculation_SelectedCrimeType]</column>
          </slices>
          <aggregation value="true" />
        </view>
        <style>
          <style-rule element="worksheet">
            <format attr="font-family" value="Tableau Book" />
            <format attr="color" value="#243447" />
            <format attr="display-field-labels" scope="rows" value="false" />
            <format attr="display-field-labels" scope="cols" value="false" />
          </style-rule>
          <style-rule element="gridline">
            <format attr="line-visibility" scope="rows" value="off" />
            <format attr="line-visibility" scope="cols" value="off" />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-disallow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings />
            <customized-tooltip>
              <formatted-text>
                <run fontcolor="#666666">Month: </run>
                <run bold="true">&lt;[MonthlyDS].[tmn:month_start:ok]&gt;</run>
                <run fontcolor="#666666">
Reported incidents: </run>
                <run bold="true">&lt;[MonthlyDS].[sum:reported_incident_count:qk]&gt;</run>
                <run fontcolor="#666666">
Trailing 3-month average: </run>
                <run bold="true">&lt;[MonthlyDS].[sum:trailing_three_month_average:qk]&gt;</run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element="mark">
                <format attr="mark-labels-show" value="false" />
                <format attr="mark-labels-cull" value="true" />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows>[MonthlyDS].[sum:reported_incident_count:qk]</rows>
        <cols>[MonthlyDS].[tmn:month_start:ok]</cols>
      </table>
    </worksheet>
  </worksheets>
  <dashboards>
    <dashboard name="Executive Overview">
      <layout-options>
        <title>
          <formatted-text>
            <run bold="true" fontcolor="#17324D" fontname="Tableau Semibold" fontsize="22">Chicago Crime Analytics — Executive Overview</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element="dashboard">
          <format attr="background-color" value="#F5F7FA" />
        </style-rule>
      </style>
      <size maxheight="850" maxwidth="1360" minheight="850" minwidth="1360" sizing-mode="fixed" />
      <datasources>
        <datasource name="Parameters" />
      </datasources>
      <datasource-dependencies datasource="Parameters">
        <column caption="Year" datatype="string" name="[pSelectedYear]" param-domain-type="list" role="measure" type="nominal" value="&quot;2025&quot;">
          <calculation class="tableau" formula="&quot;2025&quot;" />
        </column>
        <column caption="Crime Type" datatype="string" name="[pCrimeType]" param-domain-type="list" role="measure" type="nominal" value="&quot;All Crime Types&quot;">
          <calculation class="tableau" formula="&quot;All Crime Types&quot;" />
        </column>
      </datasource-dependencies>
      <zones>
        <zone h="100000" id="1" type-v2="layout-basic" w="100000" x="0" y="0">
          <zone h="7200" id="2" type-v2="title" w="71000" x="1800" y="1200" />
          <zone h="3600" id="3" type-v2="text" w="71000" x="1800" y="7800">
            <formatted-text>
              <run fontcolor="#5B6B7C" fontname="Tableau Book" fontsize="10">Complete calendar years 2023–2025 | Official City of Chicago Crimes dataset (ijzp-q8t2)</run>
            </formatted-text>
          </zone>
          <zone custom-title="true" h="5200" id="4" mode="compact" param="[Parameters].[pSelectedYear]" type-v2="paramctrl" w="11500" x="74500" y="2200">
            <formatted-text>
              <run bold="true" fontcolor="#243447" fontsize="10">Year</run>
            </formatted-text>
          </zone>
          <zone custom-title="true" h="5200" id="5" mode="compact" param="[Parameters].[pCrimeType]" type-v2="paramctrl" w="12500" x="86500" y="2200">
            <formatted-text>
              <run bold="true" fontcolor="#243447" fontsize="10">Crime Type</run>
            </formatted-text>
          </zone>
          <zone h="15000" id="6" name="Total Reported Crimes" show-title="true" w="31200" x="1800" y="13000">
            <zone-style>
              <format attr="background-color" value="#FFFFFF" />
              <format attr="border-color" value="#D9E1E8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="15000" id="7" name="Arrest Percentage" show-title="true" w="31200" x="34400" y="13000">
            <zone-style>
              <format attr="background-color" value="#FFFFFF" />
              <format attr="border-color" value="#D9E1E8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="15000" id="8" name="Domestic Incident Percentage" show-title="true" w="31200" x="67000" y="13000">
            <zone-style>
              <format attr="background-color" value="#FFFFFF" />
              <format attr="border-color" value="#D9E1E8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="29000" id="9" name="Yearly Crime Trend" show-title="true" w="47000" x="1800" y="30000">
            <zone-style>
              <format attr="background-color" value="#FFFFFF" />
              <format attr="border-color" value="#D9E1E8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="29000" id="10" name="Crime Category Distribution" show-title="true" w="48200" x="50400" y="30000">
            <zone-style>
              <format attr="background-color" value="#FFFFFF" />
              <format attr="border-color" value="#D9E1E8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="28000" id="11" name="Monthly Crime Trend" show-title="true" w="96800" x="1800" y="61000">
            <zone-style>
              <format attr="background-color" value="#FFFFFF" />
              <format attr="border-color" value="#D9E1E8" />
              <format attr="border-style" value="solid" />
              <format attr="border-width" value="1" />
              <format attr="margin" value="6" />
            </zone-style>
          </zone>
          <zone h="7800" id="12" type-v2="text" w="96800" x="1800" y="91000">
            <formatted-text>
              <run fontcolor="#4D5F70" fontsize="9">Source extract: Sep 25, 2026 | Incident dates: Jan 1, 2023–Dec 31, 2025 | Complete years
Reported incident counts are not population-normalized crime rates. Results are descriptive and do not establish causation. Arrest percentage is the share of records marked arrest=true; it is not a clearance or conviction rate.</run>
            </formatted-text>
          </zone>
        </zone>
      </zones>
    </dashboard>
  </dashboards>
  <windows source-height="32">
    <window class="dashboard" maximized="true" name="Executive Overview">
      <viewpoints>
        <viewpoint name="Total Reported Crimes">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Arrest Percentage">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Domestic Incident Percentage">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Yearly Crime Trend">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Crime Category Distribution">
          <zoom type="entire-view" />
        </viewpoint>
        <viewpoint name="Monthly Crime Trend">
          <zoom type="entire-view" />
        </viewpoint>
      </viewpoints>
      <active id="-1" />
    </window>
  </windows>
</workbook>