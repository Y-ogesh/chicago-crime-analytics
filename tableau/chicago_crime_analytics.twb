              <calculation class="tableau" formula="[Parameters].[pCrimeType] = &quot;All Crime Types&quot; OR [primary_type] = [Parameters].[pCrimeType]" />
            </column>
            <column caption="Show Category in Distribution" datatype="boolean" name="[Calculation_CategoryDisplay]" role="dimension" type="nominal">
              <calculation class="tableau" formula="[Parameters].[pCrimeType] &lt;&gt; &quot;All Crime Types&quot; OR [incident_volume_rank] &lt;= 10" />
            </column>
            <column caption="Arrest Percentage" datatype="real" name="[Calculation_Page4ArrestPercentage]" role="measure" type="quantitative" default-format="n#,##0.0&quot;%&quot;;-#,##0.0&quot;%&quot;">
              <calculation class="tableau" formula="IF SUM([reported_incident_count]) = 0 THEN NULL ELSE 100.0 * SUM([arrest_count]) / SUM([reported_incident_count]) END" />
